@model List<EnrolmentDto>
@{
    ViewData["Title"] = "My enrolments";
}

<h1 class="mb-3">My enrolments</h1>

@if (ViewData["ApiError"] is string apiError && apiError.Length > 0)
{
    <div class="alert alert-warning">@apiError</div>
}

@if (!Model.Any())
{
    <div class="rd-card p-5 text-center">
        <h4>You have not enrolled in any events yet</h4>
        <a class="btn btn-rd mt-2" asp-controller="Home" asp-action="Index">Browse upcoming events</a>
    </div>
}
else
{
    <div class="rd-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Event</th><th>Category</th><th>Enrolled on</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td><a asp-controller="Home" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a></td>
                            <td>@e.CategoryName</td>
                            <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                            <td><span class="rd-status rd-status-@e.Status">@e.Status</span></td>
                            <td class="text-end">
                                <form asp-action="Withdraw" asp-route-id="@e.EnrolmentId" method="post"
                                      onsubmit="return confirm('Withdraw from this event?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Withdraw</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}