@model UserProfileDto
@{
    ViewData["Title"] = "My profile";
}

<h1 class="mb-3">My profile</h1>

<div class="row g-4">
    <div class="col-md-4">
        <div class="rd-card p-4 text-center">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img class="rd-avatar mb-3" src="@Model.ProfilePictureUrl" alt="Profile picture" />
            }
            else
            {
                <div class="rd-avatar mb-3 mx-auto d-flex align-items-center justify-content-center bg-secondary text-white fs-1">
                    @(Model.FullName.Length > 0 ? Model.FullName[..1].ToUpper() : "?")
                </div>
            }
            <h5 class="mb-0">@Model.FullName</h5>
            <p class="text-muted small mb-1">@Model.Email</p>
            <span class="badge rd-role-badge">@Model.Role</span>
            <p class="text-muted small mt-2 mb-0">Member since @Model.CreatedAt.ToString("dd MMM yyyy")</p>
        </div>
    </div>

    <div class="col-md-8">
        <div class="rd-card p-4 mb-4">
            <h4>Personal information</h4>
            <form asp-action="UpdateProfile" method="post">
                <div class="mb-3">
                    <label class="form-label" for="fullName">Full name</label>
                    <input class="form-control" id="fullName" name="fullName" value="@Model.FullName" maxlength="100" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control" value="@Model.Email" disabled />
                </div>
                <button type="submit" class="btn btn-rd">Save changes</button>
            </form>
        </div>

        <div class="rd-card p-4">
            <h4>Profile picture</h4>
            <form asp-action="UploadPicture" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <input class="form-control" type="file" name="picture" accept="image/*" required />
                    <div class="form-text">JPG or PNG, up to 5 MB.</div>
                </div>
                <button type="submit" class="btn btn-rd">Upload picture</button>
            </form>
        </div>
    </div>
</div>