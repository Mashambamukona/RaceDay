@model CategoriesViewModel
@{
    ViewData["Title"] = "Categories";
}

<h1 class="mb-3">Categories</h1>

@if (ViewData["ApiError"] is string apiError && apiError.Length > 0)
{
    <div class="alert alert-warning">@apiError</div>
}

@if (!Model.Events.Any())
{
    <div class="rd-card p-5 text-center">
        <h4>Create an event first</h4>
        <p class="text-muted">Categories belong to an event.</p>
        <a class="btn btn-rd" asp-action="CreateEvent">Create event</a>
    </div>
}
else
{
    <form method="get" asp-action="Categories" class="rd-card p-3 mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-md-8">
                <label class="form-label" for="eventId">Event</label>
                <select class="form-select" id="eventId" name="eventId" onchange="this.form.submit()">
                    @foreach (var e in Model.Events)
                    {
                        <option value="@e.EventId" selected="@(e.EventId == Model.SelectedEventId)">
                            @e.Name - @e.EventDate.ToString("dd MMM yyyy")
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-grid">
                <button type="submit" class="btn btn-outline-rd">Show categories</button>
            </div>
        </div>
    </form>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="rd-card p-4">
                <h4 class="mb-3">Current categories</h4>

                @if (!Model.Categories.Any())
                {
                    <p class="text-muted mb-0">This event has no categories yet. Add one using the form.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr><th>Name</th><th>Ages</th><th>Distance</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.Categories)
                                {
                                    <tr>
                                        <td>@c.Name</td>
                                        <td>
                                            @if (c.MinAge.HasValue || c.MaxAge.HasValue)
                                            {
                                                @($"{c.MinAge?.ToString() ?? "0"} - {c.MaxAge?.ToString() ?? "any"}")
                                            }
                                            else
                                            {
                                                <span>All ages</span>
                                            }
                                        </td>
                                        <td>@c.CategoryDistance.ToString("0.##") km</td>
                                        <td class="text-end">
                                            <form asp-action="DeleteCategory" asp-route-id="@c.CategoryId" asp-route-eventId="@Model.SelectedEventId"
                                                  method="post" onsubmit="return confirm('Delete this category and its enrolments?');">
                                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div class="rd-card p-4">
                <h4 class="mb-3">Add a category</h4>

                <form asp-action="AddCategory" asp-route-eventId="@Model.SelectedEventId" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="NewCategory.Name" class="form-label"></label>
                        <input asp-for="NewCategory.Name" class="form-control" placeholder="e.g. Under 20, 10 km" />
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label asp-for="NewCategory.MinAge" class="form-label"></label>
                            <input asp-for="NewCategory.MinAge" type="number" class="form-control" />
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="NewCategory.MaxAge" class="form-label"></label>
                            <input asp-for="NewCategory.MaxAge" type="number" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewCategory.CategoryDistance" class="form-label"></label>
                        <input asp-for="NewCategory.CategoryDistance" type="number" step="0.01" class="form-control" />
                    </div>

                    <button type="submit" class="btn btn-rd w-100">Add category</button>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}