@model HomeIndexViewModel
@{
    ViewData["Title"] = "Upcoming events";
}

<div class="rd-hero mb-4">
    <h1 class="mb-1">Find your next race</h1>
    <p class="mb-0">Browse upcoming runs, walks and rides, then enter in a few clicks.</p>
</div>

@if (ViewData["ApiError"] is string apiError && apiError.Length > 0)
{
    <div class="alert alert-warning">@apiError</div>
}

<form method="get" asp-action="Index" class="rd-card p-3 mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="location">Location</label>
            <input class="form-control" id="location" name="location" value="@Model.Location" placeholder="e.g. Johannesburg" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="eventType">Type</label>
            <select class="form-select" id="eventType" name="eventType">
                <option value="">All types</option>
                <option value="Run" selected="@(Model.EventType == "Run")">Run</option>
                <option value="Walk" selected="@(Model.EventType == "Walk")">Walk</option>
                <option value="Cycle" selected="@(Model.EventType == "Cycle")">Cycle</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="date">Date</label>
            <input class="form-control" type="date" id="date" name="date" value="@Model.Date?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2 d-grid gap-2 d-md-flex">
            <button type="submit" class="btn btn-rd flex-fill">Filter</button>
            <a asp-action="Index" class="btn btn-outline-rd flex-fill">Clear</a>
        </div>
    </div>
</form>

@if (!Model.Events.Any())
{
    <div class="rd-card p-5 text-center">
        <h4>No upcoming events found</h4>
        <p class="text-muted mb-0">Try changing or clearing your filters.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var e in Model.Events)
        {
            <div class="col-md-6 col-lg-4">
                <div class="rd-card h-100 d-flex flex-column">
                    @if (!string.IsNullOrEmpty(e.BannerUrl))
                    {
                        <img class="rd-banner" src="@e.BannerUrl" alt="@e.Name banner" />
                    }
                    else
                    {
                        <div class="rd-banner"></div>
                    }
                    <div class="p-3 d-flex flex-column flex-grow-1">
                        <span class="badge rd-role-badge align-self-start mb-2">@e.EventType</span>
                        <h5 class="mb-1">@e.Name</h5>
                        <p class="text-muted small mb-2">
                            @e.EventDate.ToString("ddd, dd MMM yyyy HH:mm")<br />
                            @e.Location - @e.Distance.ToString("0.##") km
                        </p>
                        <a class="btn btn-rd mt-auto" asp-action="Details" asp-route-id="@e.EventId">View details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}