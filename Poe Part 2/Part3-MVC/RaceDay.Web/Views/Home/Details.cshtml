@model EventDetailsViewModel
@{
    ViewData["Title"] = Model.Event.Name;
    var ev = Model.Event;
}

<a asp-action="Index" class="d-inline-block mb-3">&larr; Back to events</a>

@if (!string.IsNullOrEmpty(ev.BannerUrl))
{
    <img class="rd-banner-large mb-4" src="@ev.BannerUrl" alt="@ev.Name banner" />
}

<div class="rd-card p-4 mb-4">
    <span class="badge rd-role-badge mb-2">@ev.EventType</span>
    <h1 class="mb-2">@ev.Name</h1>
    <p class="text-muted mb-3">
        @ev.EventDate.ToString("dddd, dd MMMM yyyy HH:mm") - @ev.Location - @ev.Distance.ToString("0.##") km
    </p>
    <p class="mb-0">@(string.IsNullOrWhiteSpace(ev.Description) ? "No description has been added yet." : ev.Description)</p>
</div>

<div class="rd-card p-4">
    <h4 class="mb-3">Categories</h4>

    @if (Model.AlreadyEnrolled)
    {
        <div class="alert alert-info">
            You are already enrolled in this event. <a asp-controller="Participant" asp-action="MyEnrolments">View my enrolments</a>
        </div>
    }

    @if (!ev.Categories.Any())
    {
        <p class="text-muted mb-0">The organiser has not added categories yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Category</th><th>Ages</th><th>Distance</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var c in ev.Categories)
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td>
                                @if (c.MinAge.HasValue || c.MaxAge.HasValue)
                                {
                                    @($"{c.MinAge?.ToString() ?? "0"} - {c.MaxAge?.ToString() ?? "any"}")
                                }
                                else
                                {
                                    <span>All ages</span>
                                }
                            </td>
                            <td>@c.CategoryDistance.ToString("0.##") km</td>
                            <td class="text-end">
                                @if (Model.IsParticipant && !Model.AlreadyEnrolled)
                                {
                                    <form asp-action="Enrol" asp-route-eventId="@ev.EventId" asp-route-categoryId="@c.CategoryId" method="post">
                                        <button type="submit" class="btn btn-rd btn-sm">Enrol</button>
                                    </form>
                                }
                                else if (!Context.Session.IsLoggedIn())
                                {
                                    <a class="btn btn-outline-rd btn-sm" asp-controller="Account" asp-action="Login">Log in to enrol</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>