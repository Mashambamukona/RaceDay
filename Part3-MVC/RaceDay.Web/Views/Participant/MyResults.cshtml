@model List<MyResultDto>
@{
    ViewData["Title"] = "My results";
}

@functions {
    static string Ordinal(int n)
    {
        var last2 = n % 100;
        if (last2 >= 11 && last2 <= 13) return n + "th";
        return (n % 10) switch
        {
            1 => n + "st",
            2 => n + "nd",
            3 => n + "rd",
            _ => n + "th"
        };
    }
}

<h1 class="mb-3">My results</h1>

@if (ViewData["ApiError"] is string apiError && apiError.Length > 0)
{
    <div class="alert alert-warning">@apiError</div>
}

@if (!Model.Any())
{
    <div class="rd-card p-5 text-center">
        <h4>No results yet</h4>
        <p class="text-muted mb-0">Your results appear here once an organiser records them after an event.</p>
    </div>
}
else
{
    <div class="rd-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.EventName</td>
                            <td>@r.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@r.CategoryName</td>
                            <td>@r.FinishTime.ToString("c")</td>
                            <td>
                                @if (r.FinishPosition.HasValue)
                                {
                                    <strong>@Ordinal(r.FinishPosition.Value)</strong> <span class="text-muted">out of @r.TotalFinishers finishers</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not recorded</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}