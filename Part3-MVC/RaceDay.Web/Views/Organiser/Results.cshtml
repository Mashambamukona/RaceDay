@model ResultsViewModel
@{
    ViewData["Title"] = "Results";
}

<h1 class="mb-3">Results</h1>

@if (ViewData["ApiError"] is string apiError && apiError.Length > 0)
{
    <div class="alert alert-warning">@apiError</div>
}

@if (!Model.Events.Any())
{
    <div class="rd-card p-5 text-center">
        <h4>Create an event first</h4>
        <p class="text-muted">Results can only be entered for events you have created.</p>
        <a class="btn btn-rd" asp-action="CreateEvent">Create event</a>
    </div>
}
else
{
    <form method="get" asp-action="Results" class="rd-card p-3 mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-md-8">
                <label class="form-label" for="eventId">Event</label>
                <select class="form-select" id="eventId" name="eventId" onchange="this.form.submit()">
                    @foreach (var e in Model.Events)
                    {
                        <option value="@e.EventId" selected="@(e.EventId == Model.SelectedEventId)">
                            @e.Name - @e.EventDate.ToString("dd MMM yyyy")
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-grid">
                <button type="submit" class="btn btn-outline-rd">Show participants</button>
            </div>
        </div>
    </form>

    <div class="rd-card p-4">
        <p class="text-muted">
            Enter each finisher's time as <strong>hh:mm:ss</strong> (for example 00:52:31) and their finishing position.
            Only confirmed enrolments can receive a result, and a saved result cannot be changed.
        </p>

        @if (!Model.Enrolments.Any())
        {
            <p class="text-muted mb-0">Nobody has enrolled in this event yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr><th>Participant</th><th>Category</th><th>Status</th><th>Result</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var en in Model.Enrolments)
                        {
                            <tr>
                                <td>@en.ParticipantName</td>
                                <td>@en.CategoryName</td>
                                <td><span class="rd-status rd-status-@en.Status">@en.Status</span></td>
                                <td>
                                    @if (Model.Results.TryGetValue(en.EnrolmentId, out var r))
                                    {
                                        <strong>@r.FinishTime.ToString("c")</strong>
                                        @if (r.FinishPosition.HasValue)
                                        {
                                            <span class="text-muted"> - position @r.FinishPosition</span>
                                        }
                                    }
                                    else if (en.Status != "Confirmed")
                                    {
                                        <span class="text-muted">Confirm the enrolment first</span>
                                    }
                                    else
                                    {
                                        <form asp-action="RecordResult" asp-route-id="@en.EnrolmentId"
                                              asp-route-eventId="@Model.SelectedEventId" method="post"
                                              class="d-flex flex-wrap gap-2">
                                            <input class="form-control form-control-sm" style="width:130px" name="finishTime"
                                                   placeholder="00:52:31" required />
                                            <input class="form-control form-control-sm" style="width:100px" name="finishPosition"
                                                   type="number" min="1" placeholder="Position" />
                                            <button type="submit" class="btn btn-rd btn-sm">Save result</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}