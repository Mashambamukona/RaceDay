@model List<OrganiserEventDto>
@{
    ViewData["Title"] = "Dashboard";
    var upcoming = Model.Where(e => e.EventDate >= DateTime.Today).OrderBy(e => e.EventDate).ToList();
}

<div class="rd-hero mb-4">
    <h1 class="mb-1">Organiser dashboard</h1>
    <p class="mb-0">A summary of the events you have created.</p>
</div>

@if (ViewData["ApiError"] is string apiError && apiError.Length > 0)
{
    <div class="alert alert-warning">@apiError</div>
}

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="rd-card p-4 text-center">
            <div class="rd-stat">@Model.Count</div>
            <div class="text-muted text-uppercase small fw-bold">Events created</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="rd-card p-4 text-center">
            <div class="rd-stat">@Model.Sum(e => e.EnrolmentCount)</div>
            <div class="text-muted text-uppercase small fw-bold">Total enrolments</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="rd-card p-4 text-center">
            <div class="rd-stat">@upcoming.Count</div>
            <div class="text-muted text-uppercase small fw-bold">Upcoming events</div>
        </div>
    </div>
</div>

<div class="rd-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Upcoming events</h4>
        <a class="btn btn-rd btn-sm" asp-action="CreateEvent">Create event</a>
    </div>

    @if (!upcoming.Any())
    {
        <p class="text-muted mb-0">You have no upcoming events. Create one to get started.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Location</th><th>Enrolments</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in upcoming)
                    {
                        <tr>
                            <td>@e.Name</td>
                            <td>@e.EventDate.ToString("ddd, dd MMM yyyy HH:mm")</td>
                            <td>@e.Location</td>
                            <td><strong>@e.EnrolmentCount</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>