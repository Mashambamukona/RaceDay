@model EventFormViewModel
@{
    var isEdit = Model.EventId.HasValue;
    ViewData["Title"] = isEdit ? "Edit event" : "Create event";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="rd-card p-4">
            <h2 class="mb-3">@ViewData["Title"]</h2>

            <form asp-action="@(isEdit ? "EditEvent" : "CreateEvent")" asp-route-id="@Model.EventId"
                  method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                <input type="hidden" asp-for="ExistingBannerUrl" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventDate" class="form-label"></label>
                        <input asp-for="EventDate" type="datetime-local" class="form-control"
                               value="@Model.EventDate?.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="EventDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Distance" class="form-label"></label>
                        <input asp-for="Distance" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Distance" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventType" class="form-label"></label>
                        <select asp-for="EventType" class="form-select">
                            <option value="">Choose a type...</option>
                            <option value="Run">Run</option>
                            <option value="Walk">Walk</option>
                            <option value="Cycle">Cycle</option>
                        </select>
                        <span asp-validation-for="EventType" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label" for="banner">Event banner (optional)</label>
                    @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
                    {
                        <div class="mb-2"><img class="rd-banner-large" src="@Model.ExistingBannerUrl" alt="Current banner" /></div>
                    }
                    <input class="form-control" type="file" id="banner" name="banner" accept="image/*" />
                    <div class="form-text">JPG or PNG, up to 5 MB.</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-rd">@(isEdit ? "Save changes" : "Create event")</button>
                    <a class="btn btn-outline-rd" asp-action="Events">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}