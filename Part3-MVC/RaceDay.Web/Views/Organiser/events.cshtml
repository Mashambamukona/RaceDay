@model List<OrganiserEventDto>
@{
    ViewData["Title"] = "Events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">My events</h1>
    <a class="btn btn-rd" asp-action="CreateEvent">Create event</a>
</div>

@if (ViewData["ApiError"] is string apiError && apiError.Length > 0)
{
    <div class="alert alert-warning">@apiError</div>
}

@if (!Model.Any())
{
    <div class="rd-card p-5 text-center">
        <h4>You have not created any events yet</h4>
        <a class="btn btn-rd mt-2" asp-action="CreateEvent">Create your first event</a>
    </div>
}
else
{
    <div class="rd-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Event</th><th>Type</th><th>Date</th><th>Location</th><th>Distance</th><th>Enrolments</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.OrderBy(x => x.EventDate))
                    {
                        <tr>
                            <td>@e.Name</td>
                            <td>@e.EventType</td>
                            <td>@e.EventDate.ToString("dd MMM yyyy HH:mm")</td>
                            <td>@e.Location</td>
                            <td>@e.Distance.ToString("0.##") km</td>
                            <td>@e.EnrolmentCount</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-outline-rd btn-sm" asp-action="EditEvent" asp-route-id="@e.EventId">Edit</a>
                                <form asp-action="DeleteEvent" asp-route-id="@e.EventId" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this event? Its categories, enrolments and results will be deleted too.');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}